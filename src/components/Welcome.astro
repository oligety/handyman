---
import { Image } from "astro:assets";
import logoImg from "../assets/logo-m5-handyman.png";

// M5 Handyman landing page component
const services = [
	{
		id: "carpentry",
		title: "Carpentry Work",
		icon: "wood",
		tagline: "Precision Craftsmanship",
		description:
			"Custom timber work, door hanging, framing, custom shelving, skirtings, architraves, and deck maintenance built to last.",
		features: [
			"Door & window hanging and repairs",
			"Skirting boards & architraves",
			"Custom timber shelving & storage",
			"Decking repairs, sanding & oiling",
			"Cabinetry & timber modifications",
		],
	},
	{
		id: "remedial",
		title: "Remedial & Defects Work",
		icon: "shield-check",
		tagline: "Structural & Cosmetic Fixes",
		description:
			"Expert inspection and rectification for residential properties, strata defects, rot remediation, and post-construction repairs.",
		features: [
			"Strata & builder defect rectification",
			"Water damage & moisture remediation",
			"Dry rot & wet rot timber repair",
			"Movement cracks & settlement repairs",
			"Building compliance restorations",
		],
	},
	{
		id: "repairs",
		title: "General Repairs & Maintenance",
		icon: "wrench",
		tagline: "Prompt & Reliable",
		description:
			"End-to-end handyman fixes covering hardware upgrades, fixture installations, and preventative property upkeep.",
		features: [
			"Hardware, lock & handle replacements",
			"Fence, gate & latch maintenance",
			"Furniture assembly & wall mounting",
			"Flyscreen and sliding door adjustments",
			"General residential & commercial upkeep",
		],
	},
	{
		id: "plastering-rendering",
		title: "Plastering & Rendering",
		icon: "paint-brush",
		tagline: "Flawless Surfaces",
		description:
			"Professional plaster patching, hole repair, water-damaged ceiling remediation, and smooth acrylic/cement rendering.",
		features: [
			"Drywall hole & impact patching",
			"Ceiling water damage restorations",
			"Cornice repair & installation",
			"Interior & exterior wall rendering",
			"Seamless joint setting & sanding",
		],
	},
	{
		id: "tiling",
		title: "Tiling & Grouting",
		icon: "grid",
		tagline: "Clean & Sealed",
		description:
			"High-quality wall and floor tiling, kitchen splashbacks, precision re-grouting, and sanitary silicone sealing.",
		features: [
			"Floor & wall tile replacements",
			"Kitchen & bathroom splashbacks",
			"Tile re-grouting & stain remediation",
			"Anti-fungal sanitary silicone sealing",
			"Balcony & wet area tile upkeep",
		],
	},
	{
		id: "painting",
		title: "Painting & Finishing",
		icon: "palette",
		tagline: "Interior & Exterior",
		description:
			"High-grade surface preparation and painting that revives living spaces, exterior timber, facades, and trim.",
		features: [
			"Interior walls, doors & trim painting",
			"Exterior facades, fences & eaves",
			"Timber staining, varnishing & decking",
			"Patch priming & color matching",
			"Mould cleaning & anti-mould coating",
		],
	},
	{
		id: "roofing",
		title: "Roofing & Gutters",
		icon: "home",
		tagline: "Weatherproof Protection",
		description:
			"Keep your home shielded with roof leak detection, flashing repairs, downpipe fixes, and thorough gutter cleaning.",
		features: [
			"Roof leak investigation & emergency repair",
			"Broken tile replacement & re-pointing",
			"Gutter clearing, repairs & guard installation",
			"Downpipe realignments & replacements",
			"Flashing & valley weatherproofing",
		],
	},
];

const highlights = [
	{
		label: "Licensed & ABN Registered",
		detail: "NSW Lic 342519C • ABN 311025368848. Fully insured and qualified for complete peace of mind.",
	},
	{
		label: "Attention to Detail",
		detail: "Precision finishes that enhance your property.",
	},
	{
		label: "Transparent Pricing",
		detail: "Clear, upfront quotes with zero hidden surprises.",
	},
	{
		label: "Clean & Dependable",
		detail: "On-time arrival and your home left spotless.",
	},
];
---

<div class="site-wrapper">
	<!-- Navigation -->
	<header class="navbar" id="top">
		<div class="nav-container">
			<a href="#top" class="brand-logo" aria-label="M5 Handyman Homepage">
				<Image
					src={logoImg}
					alt="M5 Handyman Logo"
					width={42}
					height={42}
					class="nav-logo-badge"
				/>
				<span class="logo-text"
					>M5 Handyman<span class="dot">.</span></span
				>
			</a>
			<nav class="nav-menu" aria-label="Primary Navigation">
				<a href="#services" class="nav-link">Services</a>
				<a href="#about" class="nav-link">Why M5</a>
				<a href="#contact" class="nav-btn">Get Free Quote</a>
			</nav>
		</div>
	</header>

	<main id="main-content" tabindex="-1">
		<!-- Hero Section -->
		<section class="hero-section" aria-labelledby="hero-title">
			<div class="hero-background" aria-hidden="true">
				<div class="glow-orb orb-1"></div>
				<div class="glow-orb orb-2"></div>
				<div class="grid-overlay"></div>
			</div>

			<div class="content-container hero-container">
				<div class="hero-text-column">
					<div class="pill-badge">
						<span class="pill-dot"></span>
						<span
							>Central Coast NSW & Surrounding Areas • Fast Response</span
						>
					</div>

					<h1 id="hero-title" class="hero-title">
						Expert Craftsmanship, <br />
						<span class="gradient-text"
							>Reliable Handyman Repairs.</span
						>
					</h1>

					<p class="hero-subtitle">
						M5 Handyman delivers top-tier carpentry, remedial defect
						rectification, plastering, rendering, tiling, painting,
						and roofing repairs for residential and strata
						properties across the Central Coast, New South Wales.
					</p>

					<div class="hero-cta-group">
						<a href="#contact" class="btn btn-primary">
							<span>Request a Free Quote</span>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="18"
								height="18"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2.5"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
								><path d="M5 12h14"></path><path
									d="m12 5 7 7-7 7"></path></svg
							>
						</a>
						<a href="#services" class="btn btn-secondary">
							<span>Browse Services</span>
						</a>
					</div>

					<div class="trust-strip">
						<div class="trust-item">
							<svg
								class="trust-icon"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								aria-hidden="true"
								><path
									d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
								></path></svg
							>
							<span>Licensed & Insured • Lic 342519C</span>
						</div>
						<div class="trust-item">
							<svg
								class="trust-icon"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								aria-hidden="true"
								><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"
								></path><polyline points="22 4 12 14.01 9 11.01"
								></polyline></svg
							>
							<span>Residential & Strata Specialist</span>
						</div>
						<div class="trust-item">
							<svg
								class="trust-icon"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								aria-hidden="true"
								><polygon
									points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
								></polygon></svg
							>
							<span>5-Star Quality Workmanship</span>
						</div>
					</div>
				</div>

				<div class="hero-visual-column">
					<div class="emblem-card">
						<div class="emblem-glow" aria-hidden="true"></div>
						<Image
							src={logoImg}
							alt="M5 Handyman Service and Repairs official badge"
							width={440}
							height={440}
							loading="eager"
							fetchpriority="high"
							class="hero-emblem-img"
						/>
						<div class="emblem-floating-tag">
							<span class="star-rating">★★★★★</span>
							<span class="tag-title">Licensed & Reliable</span>
							<span class="tag-subtitle"
								>Carpentry • Remedial • Repairs</span
							>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Services Section -->
		<section
			id="services"
			class="section services-section"
			aria-labelledby="services-title"
		>
			<div class="content-container">
				<div class="section-header">
					<p class="section-tag">What We Do</p>
					<h2 id="services-title" class="section-title">
						Comprehensive Trade & Handyman Services
					</h2>
					<p class="section-description">
						From timber work and plastering to complete defect
						rectification, M5 Handyman handles jobs of all sizes
						with high-end tools, premium materials, and meticulous
						precision.
					</p>
				</div>

				<div class="services-grid">
					{
						services.map((svc) => (
							<article class="service-card" id={svc.id}>
								<div class="card-header">
									<div
										class="service-icon-wrapper"
										aria-hidden="true"
									>
										{svc.icon === "wood" && (
											<svg
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2"
											>
												<path d="m14 12 6.5-6.5a2.12 2.12 0 1 0-3-3L11 9" />
												<path d="M9 11 2.5 17.5a2.12 2.12 0 1 0 3 3L12 14" />
												<path d="m11 9 4 4" />
											</svg>
										)}
										{svc.icon === "shield-check" && (
											<svg
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2"
											>
												<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
												<path d="m9 12 2 2 4-4" />
											</svg>
										)}
										{svc.icon === "wrench" && (
											<svg
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2"
											>
												<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
											</svg>
										)}
										{svc.icon === "paint-brush" && (
											<svg
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2"
											>
												<path d="m19 11-8-8-8.6 8.6a2 2 0 0 0 0 2.8l5.2 5.2c.8.8 2 .8 2.8 0L19 11Z" />
												<path d="m5 2 5 5" />
												<path d="M2 13h15" />
												<path d="M22 20a2 2 0 1 1-4 0c0-1.6 1.7-2.4 2-4 .3 1.6 2 2.4 2 4Z" />
											</svg>
										)}
										{svc.icon === "grid" && (
											<svg
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2"
											>
												<rect
													width="18"
													height="18"
													x="3"
													y="3"
													rx="2"
												/>
												<path d="M3 9h18" />
												<path d="M3 15h18" />
												<path d="M9 3v18" />
												<path d="M15 3v18" />
											</svg>
										)}
										{svc.icon === "palette" && (
											<svg
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2"
											>
												<circle
													cx="13.5"
													cy="6.5"
													r=".5"
													fill="currentColor"
												/>
												<circle
													cx="17.5"
													cy="10.5"
													r=".5"
													fill="currentColor"
												/>
												<circle
													cx="8.5"
													cy="7.5"
													r=".5"
													fill="currentColor"
												/>
												<circle
													cx="6.5"
													cy="12.5"
													r=".5"
													fill="currentColor"
												/>
												<path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.563-2.512 5.563-5.563C22 6.5 17.5 2 12 2Z" />
											</svg>
										)}
										{svc.icon === "home" && (
											<svg
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2"
											>
												<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
												<polyline points="9 22 9 12 15 12 15 22" />
											</svg>
										)}
									</div>
									<span class="card-tagline">
										{svc.tagline}
									</span>
								</div>

								<h3 class="card-title">{svc.title}</h3>
								<p class="card-description">
									{svc.description}
								</p>

								<ul
									class="feature-list"
									aria-label={`Included in ${svc.title}`}
								>
									{svc.features.map((feature) => (
										<li>
											<svg
												viewBox="0 0 20 20"
												fill="currentColor"
												class="check-icon"
												aria-hidden="true"
											>
												<path
													fill-rule="evenodd"
													d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
													clip-rule="evenodd"
												/>
											</svg>
											<span>{feature}</span>
										</li>
									))}
								</ul>

								<div class="card-footer">
									<a
										href="#contact"
										class="card-link"
										data-service-select={svc.id}
									>
										<span
											>Enquire about this service <span
												class="visually-hidden"
												>({svc.title})</span
											></span
										>
										<svg
											xmlns="http://www.w3.org/2000/svg"
											width="16"
											height="16"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											aria-hidden="true"
										>
											<>
												<path d="M5 12h14" />
												<path d="m12 5 7 7-7 7" />
											</>
										</svg>
									</a>
								</div>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<!-- Why Choose M5 Section -->
		<section
			id="about"
			class="section about-section"
			aria-labelledby="why-title"
		>
			<div class="content-container">
				<div class="section-header">
					<p class="section-tag">The M5 Standard</p>
					<h2 id="why-title" class="section-title">
						Why Homeowners & Strata Trust M5 Handyman
					</h2>
					<p class="section-description">
						We treat your home like our own. Prompt scheduling,
						clear communication, and uncompromising quality on every
						task.
					</p>
				</div>

				<div class="highlights-grid">
					{
						highlights.map((item, idx) => (
							<div class="highlight-card">
								<span class="highlight-number">0{idx + 1}</span>
								<h3 class="highlight-title">{item.label}</h3>
								<p class="highlight-detail">{item.detail}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- Contact / Quote Form Section -->
		<section
			id="contact"
			class="section contact-section"
			aria-labelledby="contact-title"
		>
			<div class="content-container">
				<div class="contact-card">
					<div class="contact-intro">
						<p class="section-tag">Direct Quote</p>
						<h2 id="contact-title" class="contact-headline">
							Tell Us About Your Project
						</h2>
						<p class="contact-subtext">
							Whether you need urgent defect repairs, custom
							carpentry, or a full weekend refresh, send your
							details below and we’ll get back to you promptly
							with an estimate.
						</p>

						<div class="direct-contact-box">
							<div class="direct-phone-item">
								<svg
									class="direct-icon"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									aria-hidden="true"
									><path
										d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
									></path></svg
								>
								<div>
									<span class="direct-label"
										>Direct Phone:</span
									>
									<a href="tel:0498376968" class="direct-val"
										>0498 376 968</a
									>
								</div>
							</div>
							<div class="direct-phone-item">
								<svg
									class="direct-icon"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									aria-hidden="true"
									><rect
										width="20"
										height="16"
										x="2"
										y="4"
										rx="2"></rect><path
										d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"
									></path></svg
								>
								<div>
									<span class="direct-label"
										>Email Enquiries:</span
									>
									<a
										href="mailto:marlon_adap@yahoo.com"
										class="direct-val"
										>marlon_adap@yahoo.com</a
									>
								</div>
							</div>
							<div class="direct-phone-item">
								<svg
									class="direct-icon"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									aria-hidden="true"
									><path
										d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
									></path></svg
								>
								<div>
									<span class="direct-label"
										>Contractor Licence:</span
									>
									<span class="direct-val"
										>NSW Lic 342519C</span
									>
								</div>
							</div>
							<div class="direct-phone-item">
								<svg
									class="direct-icon"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									aria-hidden="true"
									><path
										d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
									></path></svg
								>
								<div>
									<span class="direct-label"
										>Business Registration:</span
									>
									<span class="direct-val"
										>ABN 311025368848</span
									>
								</div>
							</div>
						</div>
					</div>

					<form class="quote-form" id="quoteForm">
						<div class="form-row">
							<div class="form-group">
								<label for="name">Your Name *</label>
								<input
									type="text"
									id="name"
									name="name"
									required
									autocomplete="name"
									aria-errormessage="name-error"
									placeholder="John Smith"
								/>
								<span id="name-error" class="error-msg" aria-live="polite"
									>Please enter your name.</span
								>
							</div>
							<div class="form-group">
								<label for="phone">Phone Number *</label>
								<input
									type="tel"
									id="phone"
									name="phone"
									required
									autocomplete="tel"
									aria-errormessage="phone-error"
									placeholder="0412 345 678"
								/>
								<span id="phone-error" class="error-msg" aria-live="polite"
									>Please enter a valid phone number.</span
								>
							</div>
						</div>

						<div class="form-row">
							<div class="form-group">
								<label for="suburb">Suburb / Location</label>
								<input
									type="text"
									id="suburb"
									name="suburb"
									autocomplete="address-level2"
									placeholder="e.g. Gosford, Wyong, Terrigal, Erina, Woy Woy"
								/>
							</div>
							<div class="form-group">
								<label for="service">Service Required</label>
								<select id="service" name="service">
									<option value="carpentry"
										>Carpentry Work</option
									>
									<option value="remedial"
										>Remedial & Defects Work</option
									>
									<option value="repairs"
										>General Repairs & Maintenance</option
									>
									<option value="plastering"
										>Plastering & Rendering</option
									>
									<option value="tiling"
										>Tiling & Grouting</option
									>
									<option value="painting"
										>Painting & Decorating</option
									>
									<option value="roofing"
										>Roofing & Gutters</option
