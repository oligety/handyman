<script>
	const form = document.getElementById("quoteForm") as HTMLFormElement | null;
	const alert = document.getElementById("formSuccess");
	const serviceSelect = document.getElementById("service") as HTMLSelectElement | null;

	form?.addEventListener("submit", (e) => {
		e.preventDefault();
		if (alert) {
			alert.classList.add("visible");
			alert.focus();
		}
		form.reset();
	});

	// Accessible error state synchronizer: mirror :user-invalid to aria-invalid
	const updateAriaState = (event: Event) => {
		const input = event.target as HTMLElement | null;
		if (!input?.matches?.("input, textarea, select")) return;
		if (input.matches(":user-invalid")) {
			input.setAttribute("aria-invalid", "true");
		} else {
			input.removeAttribute("aria-invalid");
		}
	};

	document.addEventListener("blur", updateAriaState, true);
	document.addEventListener("input", (event) => {
		const input = event.target as HTMLElement | null;
		if (!input?.matches?.("input, textarea, select")) return;
		if (input.hasAttribute("aria-invalid")) {
			updateAriaState(event);
		}
	});

	// Customer experience enhancement: pre-select service dropdown when user clicks a card
	document.querySelectorAll<HTMLAnchorElement>("[data-service-select]").forEach((link) => {
		link.addEventListener("click", () => {
			const targetService = link.getAttribute("data-service-select");
			if (targetService && serviceSelect) {
				serviceSelect.value = targetService;
			}
		});
	});
</script>
