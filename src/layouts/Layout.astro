---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'M5 Handyman – Professional Carpentry, Repairs & Building Services | Central Coast NSW',
	description = 'M5 Handyman provides expert carpentry, remedial defects rectification, plastering, rendering, tiling, painting, and roofing services across the Central Coast, New South Wales, Australia. Quality craftsmanship and free quotes.'
} = Astro.props;

const siteURL = Astro.site ?? new URL('https://m5handyman.com');
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const socialImageURL = new URL('/favicon.png', siteURL);

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'HomeAndConstructionBusiness',
	name: 'M5 Handyman',
	description: description,
	url: canonicalURL.toString(),
	telephone: '0498 376 968',
	email: 'marlon_adap@yahoo.com',
	taxID: '311025368848',
	image: socialImageURL.toString(),
	priceRange: '$$',
	areaServed: [
		{
			'@type': 'AdministrativeArea',
			name: 'Central Coast, New South Wales'
		},
		{
			'@type': 'AdministrativeArea',
			name: 'Central Coast NSW, Australia'
		}
	],
	address: {
		'@type': 'PostalAddress',
		addressRegion: 'NSW',
		addressCountry: 'AU'
	},
	hasOfferCatalog: {
		'@type': 'OfferCatalog',
		name: 'Handyman & Trade Services',
		itemListElement: [
			{ '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Carpentry Work' } },
			{ '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Remedial & Defects Work' } },
			{ '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'General Repairs & Maintenance' } },
			{ '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Plastering & Rendering' } },
			{ '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Tiling & Grouting' } },
			{ '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Painting & Finishing' } },
			{ '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Roofing & Gutters' } }
		]
	}
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph / Facebook -->
		<meta property="og:site_name" content="M5 Handyman" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={socialImageURL} />
		<meta property="og:locale" content="en_AU" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageURL} />

		<!-- Icons -->
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/favicon.png" />

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

		<meta name="generator" content={Astro.generator} />

		<!-- JSON-LD Structured Data for Local Business SEO -->
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</head>
	<body>
		<a href="#main-content" class="skip-link">Skip to main content</a>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
		--color-bg: #090d16;
		--color-surface: #101726;
		--color-surface-hover: #172138;
		--color-border: rgba(255, 255, 255, 0.08);
		--color-border-glow: rgba(245, 158, 11, 0.35);
		--color-primary: #f59e0b;
		--color-primary-hover: #d97706;
		--color-primary-glow: rgba(245, 158, 11, 0.15);
		--color-accent: #38bdf8;
		--color-text: #f3f4f6;
		--color-text-muted: #cbd5e1;
		--color-text-dim: #94a3b8;
	}

	*, *::before, *::after {
		box-sizing: border-box;
	}

	/* Skip Link for Keyboard Navigation (WCAG 2.4.1) */
	.skip-link {
		position: absolute;
		top: -999px;
		left: 1rem;
		background: var(--color-primary);
		color: #0b0f19;
		padding: 0.75rem 1.25rem;
		font-weight: 700;
		border-radius: 8px;
		z-index: 1000;
		text-decoration: none;
		box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
		transition: top 0.2s ease-in-out;
	}

	.skip-link:focus,
	.skip-link:focus-visible {
		top: 1rem;
		outline: 3px solid #ffffff;
		outline-offset: 2px;
	}

	/* Visually Hidden Utility for Screen Readers */
	.visually-hidden:where(:not(:focus-within, :active)) {
		position: absolute !important;
		clip-path: inset(50%) !important;
		overflow: hidden !important;
		width: 1px !important;
		height: 1px !important;
		margin: -1px !important;
		padding: 0 !important;
		border: 0 !important;
		white-space: nowrap !important;
	}

	/* Accessible Focus Visible Indicator across all interactive elements */
	:where(a:any-link, button, input, select, textarea):focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: 3px;
	}

	html {
		scroll-behavior: smooth;
		font-family: var(--font-sans);
		background-color: var(--color-bg);
		color: var(--color-text);
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		scrollbar-gutter: stable;
		overflow-x: hidden;
	}

	body {
		margin: 0;
		padding: 0;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		line-height: 1.6;
		overflow-x: hidden;
	}

	img, svg {
		display: block;
		max-width: 100%;
	}

	button, input, textarea, select {
		font-family: inherit;
	}

	/* Accessibility: Respect Reduced Motion Preferences */
	@media (prefers-reduced-motion: reduce) {
		*, *::before, *::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
			scroll-behavior: auto !important;
		}
	}
</style>
